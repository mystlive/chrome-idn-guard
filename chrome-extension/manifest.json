{
  "manifest_version": 3,
  "name": "文字なりすましURLチェッカー",
  "short_name": "URL文字チェック",
  "version": "0.2.0",
  "description": "国際化ドメインの紛らわしい文字を端末内だけで検査。自動監視は利用者が許可した場合のみ。",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "文字なりすましURLチェッカー（クリックで検査）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
