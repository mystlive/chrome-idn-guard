{
  "manifest_version": 3,
  "name": "文字なりすましURLチェッカー",
  "short_name": "URL文字チェック",
  "version": "0.3.0",
  "description": "リンク先と読み込み中の国際化ドメインを端末内で検査。全サイト確認は任意で有効化できます。",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab"
  ],
  "optional_permissions": [
    "tabs",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "文字なりすましURLチェッカー（クリックで検査）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
